# ⚠️ .env.example - Ortam Değişkenleri Şablonu

# BU DOSYA PUBLIC'TİR!
# Asla gerçek değerleri buraya yazma
# Lokal development için .env dosyası oluştur

---

## 📚 MAKALE YAZIMI PARAMETRELERI

# Hedef dergi adı
TARGET_JOURNAL="Target Journal Name (e.g., European Journal of..."

# Makale başlığı (draft)
ARTICLE_TITLE="Article Title (will be finalized during writing)"

# Çalışma türü
STUDY_TYPE="retrospective_cohort"  # Options: prospective, retrospective, RCT, case-control, etc.

# Ana endpoint/biomarker
PRIMARY_ENDPOINT="Primary Outcome Variable"

# İkincil endpoint'ler (virgülle ayrılmış)
SECONDARY_ENDPOINTS="Secondary Outcome 1, Secondary Outcome 2"

# Hedef katılımcı sayısı
TARGET_SAMPLE_SIZE="0"  # Sadece sayı, örnek: 352

# Çalışma popülasyonu
STUDY_POPULATION="Patient/participant group description"

# Anahtar kelimeler (virgülle ayrılmış)
KEYWORDS="keyword1, keyword2, keyword3, keyword4, keyword5"

---

## 👥 İŞBİRLİĞİ PARAMETRELERI

# Repository sahibinin adı (Anonymized veya GitHub username)
OWNER_NAME="Repository Owner"

# Co-author sayısı
CO_AUTHOR_COUNT="0"

# Yazım deadline (YYYY-MM-DD)
SUBMISSION_DEADLINE="2026-05-30"

# İnternal review deadline (YYYY-MM-DD)
INTERNAL_REVIEW_DEADLINE="2026-05-15"

---

## 📊 YAZIM SÜRECI PARAMETRELERI

# Literatür sayısı (tahmini)
ESTIMATED_REFERENCES="50"  # Range: 40-80

# Beklenen makale uzunluğu (sözcük)
ESTIMATED_WORD_COUNT="3500"  # Genelde 3000-4000

# Figür sayısı
FIGURE_COUNT="3"  # Örneğin: Flowchart, ROC curve, Forest plot

# Tablo sayısı
TABLE_COUNT="3"  # Örneğin: Demographics, Univariate, Multivariate

# Tablo başına satır sayısı (ortalama)
AVG_ROWS_PER_TABLE="25"

---

## 🔒 GÜVENLİK PARAMETRELERI (Lokal geliştirme için)

# API Keys (GEMİŞ, eğer gerekirse)
# API_KEY_JOURNAL="your-journal-api-key-here"
# API_KEY_REFERENCE_DB="your-reference-db-key-here"

# Database bağlantıları (eğer research data store'u varsa)
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="research_database"
# DB_USER="user"
# DB_PASSWORD="secure-password"

# GitHub Personal Access Token (PR automation için, opsiyonel)
# GITHUB_TOKEN="ghp_xxxxxxxxxxxx"

---

## 📝 SOCRATIC METODOLOJI PARAMETRELERI

# Otomatik feedback verbose mode
VERBOSE_FEEDBACK="true"  # false olursa sadece kısaca feedback ver

# Örnek makale sayısı (Socratic metodolojide)
EXAMPLE_COUNT="2"  # Her kalıp cümle için kaç örnek göster

# Geri bildirim detay seviyesi
FEEDBACK_LEVEL="detailed"  # Options: brief, standard, detailed

---

## 📋 KONTROL LİSTESİ

# Setup kontrol
SETUP_COMPLETE="false"  # true yapılınca tüm dosyalar hazır

# Literature review tamamlandı mı?
LITERATURE_REVIEW_DONE="false"

# Outline hazırlandı mı?
OUTLINE_READY="false"

# Methods & Results yazıldı mı?
METHODS_RESULTS_READY="false"

# Introduction yazıldı mı?
INTRODUCTION_READY="false"

# DISCUSSION yazıldı mı?
DISCUSSION_READY="false"

---

## 🚀 NASIL KULLANILIR

### 1. Lokal .env dosyası oluştur

```bash
cp .env.example .env
```

### 2. .env dosyasını doldur (GERÇEKişlerle)

```bash
# .env (lokal, .gitignore'da)
TARGET_JOURNAL="European Journal of Cardio-Thoracic Surgery"
ARTICLE_TITLE="HALP Score for AKI Prediction in CABG"
TARGET_SAMPLE_SIZE="352"
# ... diğer parametreler
```

### 3. .env dosyasını GİTTEN SAKLA

```bash
# .gitignore'da olmalı
.env
.env.local
.env.*.local
```

### 4. Version Control'de sadece .env.EXAMPLE kalır

```bash
git add .env.example
git add .gitignore
git commit -m "Add: Environment configuration template (.env.example)"
```

---

## ⚠️ ASLA YAPMA

```
❌ .env dosyasını commit etme
❌ Gerçek API keys'i bu dosyada sakla
❌ Hassas araştırma verilerini buraya yazma
❌ Hastalar/kişilerin gerçek adlarını kullan
❌ Production values'ı örnek olarak göster
```

---

## ✅ YAPMAN GEREKENLER

```
✅ Lokal .env dosyasına gerçek değerleri yaz
✅ .env.example'ı public-safe tut
✅ Parametreleri açıkça adlandır
✅ Template'leri örnek değerlerle doldur
✅ .gitignore'da .env dosyasını ekle
```

---

## 🔄 GÜNCELLEMELER

Yeni parametrelere ihtiyaç duyarsan:

1. `YAZIM_ASISTANI_SKILL.md`'a dokümantasyon ekle
2. `.env.example`'a parameter ekle
3. Lokal `.env`'ine değeri yaz
4. Git commit'te yalnız `.env.example`'ı ekle

