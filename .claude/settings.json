{
  "plugins": [
    "./superpowers"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "./superpowers/hooks/run-hook.cmd session-start",
            "async": false
          }
        ]
      }
    ]
  }
}
